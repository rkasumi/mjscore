{
  "name": "mjscore",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "build": "pnpm -s build:web && pnpm -s build:api",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "pnpm -s lint && pnpm -s build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lz-string": "^1.5.0",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.2.6",
    "react-number-format": "^5.4.5",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencyNotes": {
    "recharts": "Charts for point trends",
    "express": "Session sync API server",
    "cors": "Optional explicit CORS allowlist for local cross-origin development",
    "lz-string": "Compressed snapshot links",
    "tailwindcss": "UI styling",
    "tsx": "Run API server in dev",
    "vitest": "Unit tests for scoring"
  }
}
