{
  "name": "mjscore",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "24.18.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "backup:sqlite": "tsx server/backup-sqlite.ts",
    "migrate:json": "tsx server/migrate-json.ts",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.build.json",
    "build": "pnpm -s build:web && pnpm -s build:api",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm -s lint && pnpm -s build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lz-string": "^1.5.0",
    "postcss": "^8.5.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "react-number-format": "^5.4.5",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "dependencyNotes": {
    "recharts": "Charts for point trends",
    "express": "Session sync API server",
    "cors": "Optional explicit CORS allowlist for local cross-origin development",
    "lz-string": "Compressed snapshot links",
    "tailwindcss": "UI styling",
    "tsx": "Run API server in dev",
    "vitest": "Unit tests for scoring"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7.29.0": "7.29.6",
      "body-parser@2.2.2": "2.3.0",
      "brace-expansion@1.1.12": "1.1.18",
      "brace-expansion@5.0.6": "5.0.9",
      "esbuild@0.28.0": "0.28.2",
      "flatted@3.3.3": "3.4.2",
      "js-yaml@4.1.1": "4.3.1",
      "minimatch@3.1.2": "3.1.4",
      "qs@6.15.1": "6.15.3"
    }
  }
}
