{
  "name": "mjscore",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "build": "pnpm -s build:web && pnpm -s build:api",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "check": "pnpm -s lint && pnpm -s build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-number-format": "^5.4.5",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  },
  "dependencyNotes": {
    "recharts": "Charts for point trends",
    "express": "Session sync API server",
    "cors": "Allow cross-origin polling",
    "lz-string": "Compressed snapshot links",
    "tailwindcss": "UI styling",
    "tsx": "Run API server in dev",
    "vitest": "Unit tests for scoring"
  }
}
